# Copy to /etc/hydranet/backend.env on the VPS.
# Never commit the real file or paste secrets into source control.
DB_NAME=hydranet
MONGO_URL=mongodb+srv://REPLACE_WITH_MONGODB_ATLAS_CONNECTION_STRING
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_PASSWORD=REPLACE_WITH_INITIAL_ADMIN_PASSWORD
ADMIN_USERNAME=admin
ADMIN_RECOVERY_EMAIL=admin@example.com

# Optional email notifications:
# RESEND_API_KEY=
# SENDER_EMAIL=onboarding@resend.dev
# CONTACT_NOTIFICATION_EMAIL=

# The default Nginx layout is same-origin, so the frontend calls /api.
# Replace with your final HTTPS origin after TLS is enabled.
CORS_ORIGINS=http://REPLACE_WITH_YOUR_DOMAIN