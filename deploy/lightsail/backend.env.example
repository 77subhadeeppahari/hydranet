# Copy to /etc/hydranet/backend.env on the Lightsail server.
# Never commit the real file or paste secrets into source control.
DB_NAME=hydranet
MONGO_URL=mongodb+srv://REPLACE_WITH_MONGODB_ATLAS_CONNECTION_STRING
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_PASSWORD=REPLACE_WITH_INITIAL_ADMIN_PASSWORD
ADMIN_USERNAME=admin
ADMIN_RECOVERY_EMAIL=admin@example.com

# Optional email notifications:
# RESEND_API_KEY=
# SENDER_EMAIL=onboarding@resend.dev
# CONTACT_NOTIFICATION_EMAIL=

# FastAPI CORS is not needed for the same-domain Nginx layout.
CORS_ORIGINS=https://REPLACE_WITH_YOUR_DOMAIN